{
	"schemaVersion": 1,
	"id": "langmod",
	"version": "${version}",
	"name": "LangMod",
	"description": "Learn a language through exposure: say an item's name out loud in Mandarin Chinese, Spanish, French, Korean, Russian, Dutch, Latin, Tagalog, Japanese, Bosnian, Portuguese, Vietnamese, German or English the first time you pick it up, and talk with villagers in Korean or English. Speech recognition runs locally with whisper.cpp.",
	"authors": [
		"DylanTopic"
	],
	"contact": {
		"homepage": "https://github.com/DylanTopic/MinecraftLanguageMod",
		"sources": "https://github.com/DylanTopic/MinecraftLanguageMod",
		"issues": "https://github.com/DylanTopic/MinecraftLanguageMod/issues"
	},
	"license": "MIT",
	"icon": "assets/langmod/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"io.github.dylantopic.langmod.LangMod"
		],
		"client": [
			"io.github.dylantopic.langmod.client.LangModClient"
		],
		"modmenu": [
			"io.github.dylantopic.langmod.client.compat.ModMenuIntegration"
		]
	},
	"mixins": [
		"langmod.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.1.2",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
