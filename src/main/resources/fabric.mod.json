{
	"schemaVersion": 1,
	"id": "langmod",
	"version": "${version}",
	"name": "LangMod",
	"description": "Learn a language through exposure: say an item's name out loud in Mandarin Chinese, Spanish, French, Korean, Russian, Dutch, Tagalog, Japanese, Bosnian or Portuguese the first time you pick it up. Speech recognition runs locally with whisper.cpp.",
	"authors": [
		"DylanTopic"
	],
	"contact": {
		"sources": "https://github.com/DylanTopic/MinecraftLanguageMod"
	},
	"license": "All-Rights-Reserved",
	"icon": "assets/langmod/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"io.github.dylantopic.langmod.LangMod"
		],
		"client": [
			"io.github.dylantopic.langmod.client.LangModClient"
		],
		"modmenu": [
			"io.github.dylantopic.langmod.client.compat.ModMenuIntegration"
		]
	},
	"mixins": [
		"langmod.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.1.2",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
